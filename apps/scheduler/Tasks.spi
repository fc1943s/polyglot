/// ## Tasks (Polyglot)
:< testing

:< sm'_operators

/// ## task_id
:! task_id = string

/// ## task_name
:! task_name = string

/// ## manual_scheduling
:| manual_scheduling =
    | WithSuggestion
    | WithoutSuggestion

/// ## day_offset
:! day_offset = int

/// ## week_offset
:! week_offset = int

/// ## month_offset
:! month_offset = int

/// ## recurrency_offset
:| recurrency_offset =
    | Days : day_offset
    | Weeks : week_offset
    | Months : month_offset

/// ## fixed_recurrency
:| fixed_recurrency =
    | Weekly : date_time.day_of_week
    | Monthly : date_time.day
    | Yearly : date_time.day * date_time.month

/// ## recurrency
:| recurrency =
    | Offset : recurrency_offset
    | Fixed : list fixed_recurrency

/// ## scheduling
:| scheduling =
    | Manual : manual_scheduling
    | Recurrent : recurrency

/// ## task
:== task =
    {
        id : task_id
        name : task_name
        scheduling : scheduling
    }

/// ## date
:== date =
    {
        year : date_time.year
        month : date_time.month
        day : date_time.day
    }

/// ## status
:| status =
    | Postponed : option ()

/// ### action
:| action =
    | SetDate : date
    | AddTask : task
    | SetScheduling : task * scheduling
    | AddStatus : task * date * status

:= get_actions () : list action =
    :< date_time
    [
        SetDate {
            year = year 2000
            month = February
            day = day 29
        }
        AddTask {
            id = task_id "1"
            name = task_name "1"
            scheduling = Manual WithSuggestion
        }
        AddTask {
            id = task_id "02"
            name = task_name "02"
            scheduling = Manual WithSuggestion
        }
        AddTask {
            id = task_id "00003"
            name = task_name "00003"
            scheduling = Manual WithSuggestion
        }
    ]

///> zig
test get_actions =
    get_actions ()
    |> sm'.format_debug
    |> _assert sm'.contains "00003"

///> zig
test get_actions_2 =
    get_actions ()
    |> listm'.try_item 3i32
    |> \|
        | Some (AddTask { name }) => name
    |> _assert_eq (task_name "00003")

:= print padding cols =
    ({ lines = []; last_lines = []; max_acc = 0i32 }, cols)
    ||> listm.fold \ { last_lines max_acc } lines =>
        := { count max } =
            (lines, { count = 0i32; max = 0i32 })
            ||> listm.foldBack \ line { count max } => {
                count = count + 1
                max =
                    := len = line |> sm'.length
                    ? len > max
                    ?> len
                    |: max
            }
        := { lines } =
            (lines, { lines = []; i = 0i32 })
            ||> listm.foldBack \ line { lines i } => {
                lines =
                    := last_line =
                        last_lines
                        |> listm'.try_item (count - i - 1)
                        |> optionm'.default_with \ () =>
                            " " |> sm'.replicate max_acc
                    := line =
                        ? padding = 0
                        ?> line
                        |:
                            := padding = " " |> sm'.replicate padding
                            line ++# padding
                    := line = line |> sm'.pad_right (max + padding) ' '
                    last_line ++# line :: lines
                i = i + 1
            }
        {
            lines
            last_lines = lines
            max_acc = max_acc + max + padding
        }
    |> \ x => x.lines
    |> listm'.box
    |> seq.of_list'
    |> sm'.concat "\n"

:= col () =
    [ "Task" ]
    ++ (
        get_actions ()
        |> listm.map \|
            | AddTask { name } =>
                := (task_name name) = name
                name
            | _ => ""
    )

:= cols () =
    [
        col ()
        col ()
        [ "a"; "b"; "c"; "d"; "e" ]
    ]

///> zig
test cols =
    cols ()
    |> print 1i32
    |> console.write_line

:= task_name_width () =
    (0, get_actions ())
    ||> listm.fold \ acc => \|
        | AddTask { name } =>
            := (task_name name) = name
            := l = name |> sm'.length
            ? l > acc
            ?> l
            |: acc
        | _ => acc
    |> (+) 1


:= header_lines () =
    ("" |> sm'.pad_right (task_name_width ()) ' ')
    ++# "|" ++# " 2000               "
    ++# "|\n"

    ++# ("" |> sm'.pad_right (task_name_width ()) ' ')
    ++# "|" ++# " february  "
    ++# "|" ++# " march  "
    ++# "|\n"

    ++# ("" |> sm'.pad_right (task_name_width ()) ' ')
    ++# "|" ++# "sa"
    ++# "|" ++# "su"
    ++# "|" ++# "mo"
    ++# "|" ++# "tu"
    ++# "|" ++# "we"
    ++# "|" ++# "th"
    ++# "|" ++# "fr"
    ++# "|\n"

    ++# ("" |> sm'.pad_right (task_name_width ()) ' ')
    ++# "|" ++# "26"
    ++# "|" ++# "27"
    ++# "|" ++# "28"
    ++# "|" ++# "29"
    ++# "|" ++# "01"
    ++# "|" ++# "02"
    ++# "|" ++# "03"
    ++# "|"

:= lines () =
    (header_lines (), get_actions ())
    ||> listm.fold \ acc => \|
        | AddTask { name } =>
            := (task_name name) = name
            ? acc = ""
            ?> acc
            |: acc ++# "\n"
            ++# (name |> sm'.pad_right (task_name_width ()) ' ')
            ++# "|" ++# console.color_bright_white () ++# "??" ++# console.color_reset ()
            ++# "|" ++# console.color_bright_white () ++# "??" ++# console.color_reset ()
            ++# "|" ++# console.color_bright_green () ++# "??" ++# console.color_reset ()
            ++# "|" ++# console.color_yellow () ++# "??" ++# console.color_reset ()
            ++# "|" ++# console.color_bright_red () ++# "??" ++# console.color_reset ()
            ++# "|" ++# console.color_bright_magenta () ++# "??" ++# console.color_reset ()
            ++# "|" ++# console.color_bright_cyan () ++# "??" ++# console.color_reset ()
            ++# "|"
        | _ => acc

///> zig
test lines =
    lines () |> console.write_line
